{
	"name": "up-im-cms-mcp",
	"version": "0.1.3",
	"description": "MCP-сервер для администрирования сайтов на up-im CMS",
	"type": "module",
	"bin": {
		"up-im-cms-mcp": "build/index.js"
	},
	"files": [
		"build",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"check": "tsc --noEmit",
		"start": "node build/index.js",
		"dev": "node src/index.ts",
		"rest": "node src/rest.ts",
		"release": "sh scripts/release.sh patch",
		"release:minor": "sh scripts/release.sh minor"
	},
	"engines": {
		"node": ">=20"
	},
	"license": "UNLICENSED",
	"private": true,
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"express": "^5.2.1",
		"papaparse": "^5.7.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.2",
		"@types/papaparse": "^5.5.2",
		"typescript": "^7.0.2"
	}
}
